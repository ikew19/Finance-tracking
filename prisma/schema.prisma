generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model comptes {
  numc         String         @id @db.VarChar(19)
  idu          String?        @db.VarChar(30)
  nom          String         @unique
  solde        Int?           @default(0)
  typec        type_card
  utilisateurs utilisateurs?  @relation(fields: [idu], references: [idu], onDelete: Cascade)
  transactions transactions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  idt         BigInt   @id @default(autoincrement())
  numc        String?  @db.VarChar(19)
  idc     String?
  montant     Int?
  description String?
  typet       String?
  categorie categories? @relation(fields: [idc], references: [idc])
  datet       DateTime @default(now())
  comptes     comptes? @relation(fields: [numc], references: [numc], onDelete: Cascade)
}

model utilisateurs {
  idu     String    @id @default(cuid())
  nom     String
  email   String    @unique
  mdp     String?
  comptes comptes[]
  budgets    budgets[]
  categories categories[]
}

model categories {
  idc String   @id @default(cuid())
  nom   String   @unique
  idu   String?  // null = catégorie globale, sinon catégorie perso de l'utilisateur
  user  utilisateurs? @relation(fields: [idu], references: [idu], onDelete: Cascade)

  transactions transactions[]
  budgets      budgets[]
}

model budgets {
  idb        String   @id @default(cuid())
  idu        String
  idc        String
  montantPrevu Int
  mois       Int      // 1-12
  annee      Int
  user       utilisateurs @relation(fields: [idu], references: [idu], onDelete: Cascade, onUpdate: Cascade)
  categorie    categories   @relation(fields: [idc], references: [idc])
  @@unique([idu, idc, mois, annee])
}

enum type_card {
  visa
  mastercard
  discover
  interac
  american_express @map("american express")
}
