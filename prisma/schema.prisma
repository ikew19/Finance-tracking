generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model comptes {
  numc         String         @id @db.VarChar(19)
  idu          String?        @db.VarChar(30)
  nom          String         @unique
  solde        Int?           @default(0)
  typec        type_card
  utilisateurs utilisateurs?  @relation(fields: [idu], references: [idu], onDelete: Cascade)
  transactions transactions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  idt         BigInt   @id @default(autoincrement())
  numc        String?  @db.VarChar(19)
  montant     Int?
  description String?
  categorie   String?
  typet       String?
  comptes     comptes? @relation(fields: [numc], references: [numc], onDelete: Cascade)
}

model utilisateurs {
  idu     String    @id @db.VarChar(30)
  nom     String
  email   String    @unique
  mdp     String?
  comptes comptes[]
}

enum type_card {
  visa
  mastercard
  discover
  interac
  american_express @map("american express")
}
